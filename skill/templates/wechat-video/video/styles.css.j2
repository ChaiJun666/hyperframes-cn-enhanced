* {
  box-sizing: border-box;
}

body {
  margin: 0;
  width: 1080px;
  height: 1920px;
  overflow: hidden;
  background: #06060a;
  color: #ffffff;
  font-family: "Noto Sans SC", "Microsoft YaHei", sans-serif;
}

[data-composition-id="main"] {
  position: relative;
  width: 1080px;
  height: 1920px;
  overflow: hidden;
  background: #06060a;
}

.scene {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.scene::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 20%, rgba(245, 158, 11, 0.2), transparent 32%),
    linear-gradient(180deg, #12121f 0%, #06060a 100%);
}

.sc {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 32px;
  padding: 120px 72px;
}

.brand-bar {
  position: absolute;
  top: 40px;
  left: 48px;
  right: 48px;
  z-index: 3;
  display: flex;
  justify-content: flex-end;
  font-size: 28px;
  line-height: 1;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.55);
}

.brand-bar span {
  padding: 12px 16px;
  border-radius: 6px;
  background: rgba(0, 0, 0, 0.42);
}

.transition {
  position: absolute;
  inset: 0;
  z-index: 20;
  pointer-events: none;
}

.fade-transition {
  background: #000000;
}

h1 {
  margin: 0;
  font-size: 84px;
  line-height: 1.08;
  font-weight: 900;
}

p {
  margin: 0;
  font-size: 48px;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.82);
}

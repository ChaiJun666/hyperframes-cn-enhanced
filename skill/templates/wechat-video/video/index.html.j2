<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WeChat Article Video</title>
  <link rel="stylesheet" href="styles.css">
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
</head>
<body>
  <div data-composition-id="main" data-width="1080" data-height="1920" data-start="0" data-duration="{{TOTAL_DURATION}}">
    {{SCENES}}
  </div>

  {{AUDIO_CLIPS}}

  <script>
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    gsap.utils.toArray(".scene").forEach((scene) => {
      const start = Number(scene.dataset.start || 0);
      tl.fromTo(scene.querySelector(".sc"), { opacity: 0, y: 48 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" }, start + 0.2);
    });
    window.__timelines["main"] = tl;
  </script>
</body>
</html>

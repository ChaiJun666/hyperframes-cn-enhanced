# edge-tts voice identity and language. Run `edge-tts --list-voices` to inspect choices.
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# edge-tts speaking speed offset. Positive is faster, negative is slower.
EDGE_TTS_RATE=+20%

# edge-tts output volume offset. Keep +0% unless the voice is too quiet or too loud.
EDGE_TTS_VOLUME=+0%

# edge-tts pitch offset. Keep +0Hz for natural speech.
EDGE_TTS_PITCH=+0Hz

# edge-tts voice identity and language. Run `edge-tts --list-voices` to inspect choices.
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# edge-tts speaking speed offset. Positive is faster, negative is slower.
EDGE_TTS_RATE=+20%

# edge-tts output volume offset. Keep +0% unless the voice is too quiet or too loud.
EDGE_TTS_VOLUME=+0%

# edge-tts pitch offset. Keep +0Hz for natural speech.
EDGE_TTS_PITCH=+0Hz

# Optional visible brand text in the top-right corner. Empty means no watermark/brand bar.
VIDEO_BRAND_TEXT=

# Seconds of visual hold after each measured TTS segment. Lower values reduce audio gaps.
VIDEO_SCENE_AUDIO_BUFFER=0.35

# Minimum scene duration in seconds. Keep low for fast short-video pacing.
VIDEO_MIN_SCENE_DURATION=4.5

# Optional Chinese font file copied into generated video/fonts/ and embedded with @font-face.
# On Windows/WSL this path is detected automatically when left empty.
VIDEO_CN_FONT_PATH=
